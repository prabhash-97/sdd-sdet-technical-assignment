<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SDD Automation Suite" parallel="none">

    <listeners>
        <listener class-name="com.sdd.automation.listeners.AllureTestListener"/>
    </listeners>

    <!-- Android mobile tests disabled for CI
    <test name="Mobile Tests">
        <packages>
            <package name="com.sdd.automation.tests.mobile"/>
        </packages>
    </test>
    -->

    <test name="API Tests">
        <packages>
            <package name="com.sdd.automation.tests.api"/>
        </packages>
    </test>

    <test name="Cucumber API Tests">
        <classes>
            <class name="com.sdd.automation.runners.ApiCucumberTestRunner"/>
        </classes>
    </test>

</suite>