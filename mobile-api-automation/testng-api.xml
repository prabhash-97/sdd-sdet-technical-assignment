<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SDD API Automation Suite" parallel="none">
    <listeners>
        <listener class-name="com.sdd.automation.listeners.AllureTestListener"/>
    </listeners>
    <test name="API Tests">
        <packages>
            <package name="com.sdd.automation.tests.api"/>
        </packages>
    </test>
    <test name="Cucumber API Tests">
        <classes>
            <class name="com.sdd.automation.runners.ApiCucumberTestRunner"/>
        </classes>
    </test>
</suite>
